DEFORCMT DS    CL21           DE-FORMAT-COMMENT                         00006700
DEDELFLG DS    CL1            DE-DELETE-ELEMENT-FLAG                    00006800
DEDELETE EQU   C'D'              DE-DELETE                              00006901
DERPRTFL DS    CL1            DE-AUTO-REPRINT-FLAG                      00007000
DERPRINT EQU   C'Y'              DE-REPRINT                             00007101
DERECPOS DS    PL3            DE-RECORD-POS           S9(5)             00007200
DESTRLEN DS    PL2            DE-STORED-LENGTH        S9(3)             00007300
DESTRDEC DS    PL2            DE-STORED-DECIMALS      S9(3)             00007400
DESTRFRM DS    CL1            DE-STORED-FORMAT                          00007500
DEBIN    EQU   C'B'              DE-BIN                                 00007601
DECHAR   EQU   C'C'              DE-CHAR                                00007701
DEDISPLY EQU   C'D'              DE-DISPLAY                             00007801
DEPACKED EQU   C'P'              DE-PACKED                              00007901
DEHEX    EQU   C'X'              DE-HEX                                 00008001
DECODFLG DS    CL1            DE-CODES-FLAG                             00008100
DECODED  EQU   C'Y'               DE-HAS-CODE-VALUES                    00008201
DECVALCT DS    H              DE-CODE-VALUES-CT       S9(4) COMP        00008302
